# PromptBranch team development stack — LOCAL ONLY synthetic credentials.
# Copy to deploy/team/.env (git-ignored) before `pnpm team:dev:up`.
# These values are safe only on 127.0.0.1; never reuse them anywhere real
# (contract C10: production requires separate non-test identity config).

# --- PostgreSQL (deploy/team/compose.dev.yml) -------------------------------
TEAM_SUPERUSER_PG_PASSWORD=team_postgres_dev_pw
TEAM_APP_PG_PASSWORD=team_app_dev_pw
TEAM_MIGRATE_PG_PASSWORD=team_migrate_dev_pw
TEAM_ADMIN_PG_PASSWORD=team_admin_dev_pw
KEYCLOAK_PG_PASSWORD=keycloak_dev_pw

# --- Keycloak ---------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=promptbranch-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=keycloak_admin_dev_pw
# Confidential client secret for `promptbranch-web`; the realm import file
# resolves ${WEB_CLIENT_SECRET:...} with this value.
WEB_CLIENT_SECRET=pb-team-web-dev-secret

# --- Reference endpoints (contract C10) --------------------------------------
TEAM_OIDC_ISSUER=http://127.0.0.1:48080/realms/promptbranch-dev
TEAM_SMTP_URL=smtp://127.0.0.1:48025
TEAM_EMAIL_FROM=team-no-reply@promptbranch.test
TEAM_PUBLIC_ORIGIN=http://127.0.0.1:4317

# --- Team server (host process; used by scripts/team-migrate.mjs) -----------
TEAM_DATABASE_URL=postgresql://team_app:team_app_dev_pw@127.0.0.1:54329/team
TEAM_MIGRATION_DATABASE_URL=postgresql://team_migrate:team_migrate_dev_pw@127.0.0.1:54329/team

# --- Team tests (used by scripts/team-test.mjs / test harness) --------------
TEAM_TEST_DATABASE_URL=postgresql://team_admin:team_admin_dev_pw@127.0.0.1:54329/postgres
TEAM_TEST_MIGRATION_DATABASE_URL=postgresql://team_migrate:team_migrate_dev_pw@127.0.0.1:54329/team_test
TEAM_TEST_APP_DATABASE_URL=postgresql://team_app:team_app_dev_pw@127.0.0.1:54329/team_test
