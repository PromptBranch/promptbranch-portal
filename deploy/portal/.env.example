# Copy this file to .env on the server and keep the copy mode 600.
PUBLIC_BASE_URL=https://promptbranch.app
TZ=Asia/Jerusalem
DISABLE_IPV6=true
IP_RANGES_FETCH_ENABLED=false

# The NPM image is pinned by digest. Update deliberately after reviewing the
# released image and backing up the NPM volumes.
NPM_IMAGE=docker.io/jc21/nginx-proxy-manager@sha256:52b2c59994f3d36acfcf70a1626f29734df0ed8c71bacc0269f78b6f939858bb
PORTAL_IMAGE_TAG=0.5.0

# First boot only: NPM creates the initial admin from these values when its
# database is empty. Delete both lines from the server .env after first boot.
# INITIAL_ADMIN_EMAIL=your-email@example.com
# INITIAL_ADMIN_PASSWORD=generate-a-long-unique-password
