{
  "name": "promptbranch-portal-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @promptbranch/portal dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @promptbranch/portal start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "team:dev:up": "docker compose -f deploy/team/compose.dev.yml up -d --wait && node scripts/team-keycloak-init.mjs",
    "team:dev:down": "docker compose -f deploy/team/compose.dev.yml down",
    "team:keycloak:init": "node scripts/team-keycloak-init.mjs",
    "team:migrate": "pnpm --filter @promptbranch/team-server build && node scripts/team-migrate.mjs",
    "team:worker": "pnpm --filter @promptbranch/team-server build && node scripts/team-worker.mjs",
    "team:backup": "pnpm --filter @promptbranch/team-server build >/dev/null && node scripts/team-backup.mjs",
    "team:restore": "pnpm --filter @promptbranch/team-server build >/dev/null && node scripts/team-restore.mjs",
    "team:benchmark": "pnpm --filter @promptbranch/team-server build >/dev/null && node scripts/team-benchmark.mjs",
    "team:integration": "node scripts/team-integration.mjs",
    "team:fixtures": "node scripts/team-fixtures.mjs",
    "test:team": "node scripts/team-test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
