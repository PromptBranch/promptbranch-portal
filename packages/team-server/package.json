{
  "name": "@promptbranch/team-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PromptBranch team workspaces server foundation: PostgreSQL storage, forward-only migrations and workspace transactions. Server-only; never imported by browser code.",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@promptbranch/share": "workspace:*",
    "jose": "6.2.12",
    "nodemailer": "10.0.10",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
