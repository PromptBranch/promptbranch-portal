{
  "protocol": 1,
  "contractVersion": "1.0.0",
  "httpMajor": "/api/team/v1",
  "features": [
    "catalog-v1",
    "review-v1",
    "changes-v1",
    "agent-token-v1"
  ],
  "operations": [
    "collection.create",
    "collection.delete",
    "collection.rename",
    "comment.add",
    "invitation.create",
    "invitation.revoke",
    "member.remove",
    "member.role",
    "note.add",
    "prompt.archive",
    "prompt.create",
    "prompt.metadata",
    "prompt.restore",
    "prompt.rollback",
    "proposal.review",
    "proposal.submit",
    "proposal.withdraw",
    "run.report",
    "tag.create",
    "tag.delete",
    "tag.rename",
    "workspace.delete",
    "workspace.rename"
  ],
  "receiptResultKinds": [
    "activityItem",
    "collection",
    "comment",
    "invitation",
    "member",
    "prompt",
    "proposal",
    "review",
    "tag",
    "workspace"
  ],
  "errorCodes": [
    "COMMAND_ID_REUSED",
    "CURSOR_EXPIRED",
    "LAST_OWNER",
    "MEMBERSHIP_CHANGED",
    "NOT_FOUND",
    "PAYLOAD_TOO_LARGE",
    "PROTOCOL_UNSUPPORTED",
    "QUOTA_EXCEEDED",
    "RATE_LIMITED",
    "ROLE_FORBIDDEN",
    "SCOPE_FORBIDDEN",
    "SECRET_BLOCKED",
    "SELF_REVIEW",
    "SERVER_EPOCH_CHANGED",
    "SESSION_REVOKED",
    "SNAPSHOT_EXPIRED",
    "STALE_BASE",
    "STALE_ENTITY",
    "UNAUTHENTICATED",
    "UNAVAILABLE",
    "VALIDATION_FAILED",
    "WORKSPACE_FORBIDDEN"
  ],
  "routes": [
    "DELETE /me",
    "DELETE /sessions/{sessionId}",
    "DELETE /workspaces/{workspaceId}/agent-tokens/{tokenId}",
    "GET /health/ready",
    "GET /info",
    "GET /me",
    "GET /principal",
    "GET /sessions",
    "GET /workspaces",
    "GET /workspaces/{workspaceId}",
    "GET /workspaces/{workspaceId}/activity-items",
    "GET /workspaces/{workspaceId}/agent-tokens",
    "GET /workspaces/{workspaceId}/audit",
    "GET /workspaces/{workspaceId}/bootstrap/{snapshotId}",
    "GET /workspaces/{workspaceId}/changes",
    "GET /workspaces/{workspaceId}/collections",
    "GET /workspaces/{workspaceId}/export",
    "GET /workspaces/{workspaceId}/invitations",
    "GET /workspaces/{workspaceId}/members",
    "GET /workspaces/{workspaceId}/prompts",
    "GET /workspaces/{workspaceId}/prompts/{promptId}",
    "GET /workspaces/{workspaceId}/prompts/{promptId}/revisions",
    "GET /workspaces/{workspaceId}/proposals",
    "GET /workspaces/{workspaceId}/proposals/{proposalId}",
    "GET /workspaces/{workspaceId}/proposals/{proposalId}/comments",
    "GET /workspaces/{workspaceId}/revisions/{revisionId}",
    "GET /workspaces/{workspaceId}/tags",
    "POST /invitations/accept",
    "POST /sessions/revoke-all",
    "POST /workspaces",
    "POST /workspaces/{workspaceId}/agent-tokens",
    "POST /workspaces/{workspaceId}/bootstrap",
    "POST /workspaces/{workspaceId}/commands"
  ],
  "limits": {
    "maxRequestBytes": 262144,
    "maxResponsePageBytes": 524288,
    "maxContentBytes": 65536,
    "maxPageSize": 100,
    "maxMembers": 50,
    "maxPrompts": 5000,
    "maxPublishedContentBytes": 209715200,
    "maxProposals": 50000,
    "maxActiveTokensPerMember": 20
  }
}
