{
  "name": "@promptbranch/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PromptBranch sharing portal: self-hosted Next.js service for unlisted prompt snapshots (JSON API + SSR viewer).",
  "scripts": {
    "dev": "pnpm embed:build && next dev --webpack",
    "build": "pnpm embed:build && next build --webpack",
    "embed:build": "vite build --config embed.vite.config.ts",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@promptbranch/share": "workspace:*",
    "@shikijs/rehype": "^4.5.0",
    "better-sqlite3": "13.0.3",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
